# Used by the Supabase CLI (migrations, linking). Copy to .env and fill in. Never commit .env.
SUPABASE_PROJECT_REF=qwbqzasmyatjnmnuwrun
# Dashboard → Project Settings → Database → password you chose when creating the project
SUPABASE_DB_PASSWORD=
# https://supabase.com/dashboard/account/tokens → "Generate new token"
SUPABASE_ACCESS_TOKEN=

# Twilio — phone OTP (Console → Account info / Verify → Services)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_VERIFY_SERVICE_SID=
